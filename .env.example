# =============================================================================
#  ItemShare - web application settings
# =============================================================================
#
#  This is the complete list of settings the site reads. Every one has a working
#  default, so the site starts even if you set nothing at all; what changes is
#  what it is able to do.
#
#  Getting started:
#
#      cp .env.example .env
#      chmod 600 .env          # it holds a session secret, and maybe a mail key
#      npm start
#
#  The server reads .env from this folder by absolute path, so it is found
#  whatever directory you happen to start the process from. The same is true of
#  every script here. A .env kept anywhere else is NOT read.
#
#  Blank is a valid value everywhere. It means "not configured": that feature is
#  switched off, and the site says so in its log instead of failing to start.
#
#  .env is listed in .gitignore. Never commit it.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. The site itself
# -----------------------------------------------------------------------------
#  The port the HTTP server listens on, and the address people reach it at.
#  These two have to agree: BASE_URL is what the sign-in redirects and the links
#  inside request emails are built from, so a BASE_URL pointing at localhost on
#  a deployed site sends people to a machine that is not there.
#
#  Behind a reverse proxy, keep PORT as the local port the proxy forwards to and
#  set BASE_URL to the public https address.
#
#  default: 3000                              default: http://localhost:<PORT>
PORT=3000
BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
#  2. Sessions (staying signed in)
# -----------------------------------------------------------------------------
#  SESSION_SECRET signs the session cookie. Leave it blank and the site makes a
#  random one on every boot, which means everybody is signed out on every
#  restart, including on a deploy. Generate one and keep it:
#
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#  Sessions themselves live in MariaDB, not in memory, so a restart does not
#  drop them as long as this value stays the same.
#
#  SESSION_TTL_DAYS is how long a sign-in lasts. It is renewed on each visit, so
#  somebody who drops by now and then never sees a login screen. The floor is 1;
#  there is no way to turn sessions off.
#
#  default: random per boot                    default: 30 (minimum 1)
SESSION_SECRET=
SESSION_TTL_DAYS=30


# -----------------------------------------------------------------------------
#  3. Database (MariaDB)
# -----------------------------------------------------------------------------
#  The site keeps all of its state in one MariaDB database. Tell it where the
#  server is and which account to use; the database itself does not have to
#  exist yet, because the first boot creates it.
#
#  The account needs CREATE privileges on the first run, to create the database
#  and the itemshare_* tables. Ordinary read/write is enough afterwards.
#
#  ITEMSHARE_DATABASE must be letters, digits and underscores. It is deliberately
#  its own setting: MariaDB's MARIADB_DATABASE is IGNORED by this site, so it can
#  never be pointed at another application's schema by accident.
#
#  defaults: 127.0.0.1 / 3306 / root / (no password) / itemshare
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=
ITEMSHARE_DATABASE=itemshare


# -----------------------------------------------------------------------------
#  4. Sign-in: Discord  (optional)
# -----------------------------------------------------------------------------
#  Signing in does one job here: it establishes who someone is, so their ESO
#  accounts can be linked to them and requests can be addressed to a person.
#
#  Create an application at https://discord.com/developers/applications, then add
#  the callback address under OAuth2 -> Redirects. Leave both the id and the
#  secret blank to switch Discord off; the button simply does not appear.
#
#  A provider is only shown when its id AND secret are both set. Discord alone,
#  Google alone, both, or neither are all valid setups.
#
#  default: off
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
#  default: <BASE_URL>/auth/discord/callback - set it only to point elsewhere,
#  and register the exact same URL with Discord.
DISCORD_REDIRECT_URI=


# -----------------------------------------------------------------------------
#  5. Sign-in: Google  (optional)
# -----------------------------------------------------------------------------
#  Create an OAuth client of type "Web application" at
#  https://console.cloud.google.com/apis/credentials and add the callback address
#  under "Authorised redirect URIs".
#
#  Google reports the name, the email address and whether that address is
#  verified, so it supplies everything Discord does. People who sign in with both
#  providers are recognised as one person when the verified addresses match.
#
#  default: off
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#  default: <BASE_URL>/auth/google/callback
GOOGLE_REDIRECT_URI=


# -----------------------------------------------------------------------------
#  6. Request email  (optional)
# -----------------------------------------------------------------------------
#  When someone sends a basket of requests, the owner of each item is emailed
#  what was asked for and which ESO account to mail it to in game. Requests work
#  perfectly well without this: they are recorded and shown on the site, and the
#  log says how many emails were not sent and why.
#
#  Without EMAIL_FROM nothing is sent, whatever else is configured. The address
#  must be one the sending server is allowed to use.
#
#  EMAIL_TRANSPORT picks how mail leaves the machine:
#
#      (blank)    automatic - the host's own mail server if one is found,
#                 otherwise Resend if an API key is set
#      sendmail   the host's mail server, via `sendmail -t`
#      resend     Resend's HTTP API
#      none       never send, without pretending it did
#
#  sendmail is the usual choice on a Linux host: give the machine a mail server
#  (postfix, exim, msmtp, opensmtpd - all provide `sendmail`) and check it with
#      echo test | sendmail -t you@example.com
#  Nothing is installed by the site itself, and no account is involved.
#
#  RESEND_API_KEY is for hosts that cannot send mail directly - a blocked port
#  25, or Windows during development. It needs an EMAIL_FROM on a domain
#  verified in Resend.
#
#  default: blank (off) / automatic / sendmail found automatically / blank
EMAIL_FROM=
EMAIL_TRANSPORT=
SENDMAIL_PATH=
RESEND_API_KEY=


# -----------------------------------------------------------------------------
#  7. The request basket
# -----------------------------------------------------------------------------
#  Asking for an item reserves it immediately, so two people cannot be promised
#  the same copy. The reservation sits in a basket until it is sent or expires.
#
#  REQUEST_HOLD_MINUTES is how long an unsent basket holds its items. The clock is
#  shared by everything in the basket, and adding or removing anything restarts
#  it. It exists to gather a few asks before sending, not to sit on somebody's
#  stack, so the range is clamped to 1-120 minutes.
#
#  REQUEST_SWEEP_INTERVAL_MS is how often the server releases baskets that ran
#  out. This runs server-side on a timer, so it also applies to someone who
#  closed the tab - nothing stays held because a browser forgot to say so.
#
#  default: 5 (range 1-120)                    default: 10000 (10 seconds)
REQUEST_HOLD_MINUTES=5
REQUEST_SWEEP_INTERVAL_MS=10000


# -----------------------------------------------------------------------------
#  8. Item icons
# -----------------------------------------------------------------------------
#  The game records a DDS texture path per item, which browsers cannot draw, so
#  the site fetches a PNG copy once from UESP's mirror and serves it from its own
#  /icons/ route. A blank icon never repairs itself, so a timer retries them.
#
#  ICON_BACKFILL_INTERVAL_MS is how often that retry pass runs. Set it to 0 to
#  turn the pass off entirely, for a host that should not call out on its own.
#
#  ICON_BACKFILL_BATCH is how many item ids one pass may look up, which keeps a
#  large backlog from turning into a burst of requests to UESP.
#
#  None of this is required: with no network or with the pass off, rows simply
#  show no thumbnail and everything else works.
#
#  default: 1800000 (30 minutes, 0 = off)      default: 20
ICON_BACKFILL_INTERVAL_MS=1800000
ICON_BACKFILL_BATCH=20


# -----------------------------------------------------------------------------
#  9. Automatic uploads  (optional)
# -----------------------------------------------------------------------------
#  POST /ingest accepts a saved variables file from a watcher rather than from a
#  browser, so the site can stay current without anyone opening the page.
#
#  This is off unless INGEST_TOKEN is set, and every call compares the token in
#  constant time. With it blank the endpoint answers 503 and nothing else about
#  the site changes.
#
#  The same string goes to whatever is doing the watching, which posts the file
#  contents to <BASE_URL>/ingest with "Authorization: Bearer <token>".
#
#  An ingest upload is anonymous by design: it can replace item lists, but it can
#  never link an ESO account to a person or change an existing link. Keep the
#  site behind HTTPS, because the token travels in a header.
#
#  Make one with:  openssl rand -hex 32
#
#  default: blank (off)
INGEST_TOKEN=


# -----------------------------------------------------------------------------
#  10. Demonstrating live updates  (optional)
# -----------------------------------------------------------------------------
#  `npm run simulate` runs as its own process and drives fake people through real
#  requests. It cannot reach the sockets the site holds, so after each round it
#  asks the site to announce the change to open pages - authenticated with this
#  token.
#
#  With it blank, the data still changes and you see it on the next refresh; you
#  just do not see the live push.
#
#  The site it asks is BASE_URL above, so a reverse proxy or a different port needs
#  nothing extra here. `npm run simulate -- --url <address>` overrides it for one run.
#
#  default: blank (off)
SIMULATE_TOKEN=
